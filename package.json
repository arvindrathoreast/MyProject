{
  "name": "testing-starter-repo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "npx playwright test",
    "test:smoke": "npx playwright test --grep @smoke",
    "test:e2e": "npx playwright test tests/e2e && node scripts/aggregate-functional.js",
    "test:a11y": "npx playwright test tests/a11y && node scripts/aggregate-a11y.js",
    "test:visual": "npx playwright test tests/visual && node scripts/aggregate-functional.js",
    "test:functional": "npx playwright test tests/e2e tests/visual && node scripts/aggregate-functional.js",
    "report:functional": "node scripts/aggregate-functional.js",
    "test:perf": "ts-node ./scripts/run-lighthouse.ts performance",
    "report:a11y": "node scripts/aggregate-a11y.js",
    "test:seo": "npx playwright test tests/seo && node scripts/aggregate-seo.js",
    "report:seo": "node scripts/aggregate-seo.js",
    "test:robots": "npx playwright test tests/robots",
    "test:sitemap": "npx playwright test tests/sitemap",
    "test:404": "npx playwright test tests/404",
    "test:security": "npx playwright test tests/security",
    "test:analytics": "npx playwright test tests/analytics",
    "install:playwright-browsers": "npx playwright install",
    "upload:reports": "ts-node scripts/upload-reports.ts",
    "aggregate:weekly": "ts-node scripts/aggregate-weekly.ts",
    "prepare": "husky install",
    "lint": "eslint . --ext .ts,.js --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.6.2",
    "@azure/storage-blob": "^12.29.1",
    "@playwright/test": "^1.40.0",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-playwright": "^1.1.1",
    "husky": "^8.0.3",
    "lighthouse": "^10.0.0",
    "lint-staged": "^13.0.3",
    "prettier": "^3.3.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3"
  }
}
